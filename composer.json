{
    "name": "magicoli/two-way-ticket",
    "description": "A Filament ticket tracker with genuinely bidirectional GitHub sync — labels, assignee, milestone, and Projects, aligned on GitHub's own model instead of reinventing it.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "keywords": [
        "filament",
        "laravel",
        "tickets",
        "bug-reports",
        "github"
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Magicoli\\TwoWayTicket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Magicoli\\TwoWayTicket\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Magicoli\\TwoWayTicket\\TwoWayTicketServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
