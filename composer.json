{
    "name": "magicoli/two-way-ticket",
    "description": "Helpdesk truckin' down the track - Flexible ticketing system for Laravel / Filament",
    "version": "0.4.4",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "keywords": [
        "filament",
        "laravel",
        "tickets",
        "bug-reports",
        "github"
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "magicoli/extra-navigation-items": "^0.1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Magicoli\\TwoWayTicket\\": "src/",
            "Magicoli\\TwoWayTicket\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Magicoli\\TwoWayTicket\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Magicoli\\TwoWayTicket\\TwoWayTicketServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
    ]
}
